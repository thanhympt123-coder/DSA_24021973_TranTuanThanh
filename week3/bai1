#include <iostream>
#include <algorithm>
using namespace std;
int main() {
int n;
int a[100];

cout << "Nhap n: ";
cin >> n;
cout << "Nhap day so: ";
for (int i = 0; i < n; i++) {
    cin >> a[i];
}
sort(a, a + n);
cout << "Day sau khi sap xep: ";
for (int i = 0; i < n; i++) {
    cout << a[i] << " ";
}
cout << "\nTrung vi la: " << a[n / 2];
return 0;

}
